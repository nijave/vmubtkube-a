directory.default.set = /media/torrents
session.path.set = /mnt/config/session
network.bind_address.set = 10.162.220.102
system.daemon.set = true
network.scgi.open_port = "127.0.0.1:6262"
log.open_file = "rtorrent.log", (cat, "/dev/stdout")
log.add_output = "debug", "rtorrent.log"
method.redirect=load.throw,load.normal
method.redirect=load.start_throw,load.start
method.insert=d.down.sequential,value|const,0
method.insert=d.down.sequential.set,value|const,0
protocol.encryption.set = allow_incoming,try_outgoing,enable_retry
network.tos.set = throughput
pieces.hash.on_completion.set = no
pieces.preload.min_rate.set = 50000
protocol.pex.set = no
throttle.global_down.max_rate.set = 0
throttle.global_up.max_rate.set = 0
throttle.max_peers.normal.set = 100
throttle.max_peers.seed.set = -1
throttle.max_uploads.global.set = 100
throttle.min_peers.normal.set = 1
throttle.min_peers.seed.set = -1
schedule = session_save, 1200, 3600, ((session.save))
method.set_key = event.download.inserted, 2_save_session, ((d.save_full_session))
trackers.numwant.set = 100
network.max_open_sockets.set = 4096
network.max_open_files.set = 4096
network.http.max_total_connections.set = 64
network.receive_buffer.size.set = 16M
network.send_buffer.size.set    = 16M
network.xmlrpc.size_limit.set = 4M
