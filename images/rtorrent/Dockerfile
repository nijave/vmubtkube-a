# rtorrent stack image for the vmubttorrent01 -> k8s migration
# (docs/superpowers/specs/2026-08-22-torrent-vm-to-k8s-design.md).
#
# Carried over from the VM build at /mnt/docker/rtorrent with two deltas:
#   - no baked-in RPC password: nginx htpasswd and the exporter's password
#     file are generated by start.sh from the $RPC_PASSWORD env (mounted
#     from Secret rtorrent-rpc-auth)
#   - no baked-in Flood users.db: Flood state lives on the torrent-config
#     PVC (copied out of the VM container during cutover)
# Everything else is identical to the VM image (Arch base for current
# rtorrent 0.16.x — Alpine's 0.16.12 deadlocks under this workload,
# rakshasa/rtorrent#1689; Flood; aauren rtorrent-exporter v1.6.0).
# Freeze the VM's exact Arch package set at cutover time so the rebuilt
# image is version-identical for fastresume compatibility.
FROM docker.io/library/archlinux:base@sha256:4bf33b21a715aac0b48ce6e9eaed4782a898eae96f88f5da3635572129c2584a

RUN groupadd -g 1001 rtorrent \
  && useradd -g rtorrent -m -u 1002 rtorrent

RUN pacman -Sy --needed --noconfirm archlinux-keyring \
  && pacman -Syu --needed --noconfirm ca-certificates coreutils curl grep iproute2 \
    libnatpmp nftables nginx nodejs npm openssl python python-six rtorrent sudo wireguard-tools \
  && npm install --global flood \
  && pacman -Scc --noconfirm

# start.sh uses sudo for the nginx restart loop, same as the VM image.
RUN echo 'rtorrent ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/rtorrent

RUN echo '#!/usr/bin/env python3' > /usr/local/bin/xmlrpc2scgi.py \
  && curl --connect-timeout 30 --retry 3 --max-time 120 https://raw.githubusercontent.com/pyroscope/pyrobase/refs/heads/master/src/pyrobase/io/xmlrpc2scgi.py >> /usr/local/bin/xmlrpc2scgi.py \
  && sed -i 's/^import pipes/import shlex as pipes/' /usr/local/bin/xmlrpc2scgi.py \
  && chmod +x /usr/local/bin/xmlrpc2scgi.py

RUN mkdir -p /tmp/exporter \
    && cd /tmp/exporter \
    && curl --connect-timeout 30 --retry 3 --max-time 120 -LO https://github.com/aauren/rtorrent-exporter/releases/download/v1.6.0/rtorrent-exporter_Linux_amd64.tar.gz \
    && tar xf rtorrent-exporter_Linux_amd64.tar.gz \
    && mv rtorrent-*/rtorrent-exporter /usr/local/bin/ \
    && cd / \
    && rm -rf /tmp/exporter

COPY nginx.conf /etc/nginx/nginx.conf

RUN mkdir -p /mnt/config \
  && chown 1002:1001 /mnt/config \
  && mkdir -p /media

VOLUME /mnt/config
VOLUME /media

# Flood state (users.db) is expected on the mounted PVC at /var/lib/flood.
RUN mkdir -p /var/lib/flood/db/default \
  && chown -R 1002:1001 /var/lib/flood
COPY --chown=1002:1001 rtorrent.rc /home/rtorrent/.rtorrent.rc
COPY port-forward.sh /usr/local/bin/port-forward.sh
COPY start.sh /usr/local/bin/start.sh
COPY rtorrent-runner.py /usr/local/bin/rtorrent-runner.py

USER rtorrent

CMD /usr/local/bin/start.sh
